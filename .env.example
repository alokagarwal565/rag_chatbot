# Copy to .env and fill in. Everything except the Gemini key has a working default.

# --- LLM (Gemini). Keys 2 and 3 are optional; they are rotated in when a key hits its quota.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

LLM_PROVIDER=gemini
# FAST tier answers questions and rewrites follow-ups; HEAVY tier builds the eval set and judges answers.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_HEAVY=gemini-3.6-flash
# Used when the primary model of a tier is unavailable / overloaded.
GEMINI_MODEL_FALLBACK_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK_HEAVY=gemini-3.5-flash

# Output cap keeps answer latency inside the 2-5 s budget.
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=20
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=8

# --- Retrieval
DENSE_TOP_K=30
LEXICAL_TOP_K=30
RRF_K=60
RERANK_CANDIDATES=20
CONTEXT_TOP_K=6

# --- Reranker (ONNX cross-encoder via fastembed). Set false to skip reranking.
RERANKER_ENABLED=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Evidence gate: abstain when sigmoid(best rerank logit) is below this (tuned on the eval set).
ABSTAIN_THRESHOLD=0.002
# Gate used instead when the reranker is disabled (best RRF score).
RRF_ABSTAIN_THRESHOLD=0.016

# --- Embeddings / chunking (changing these requires re-ingesting with --force)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TARGET_TOKENS=480
CHUNK_MAX_TOKENS=510
CHUNK_OVERLAP_TOKENS=72

# --- OCR
OCR_BACKEND=auto
OCR_WORKERS=3
OCR_DPI=200
OCR_IMAGES_PER_DOC=0

# --- Server
PORT=7860
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
